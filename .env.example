# Copia este archivo como .env y rellena los valores. El .env no se sube al repositorio.

# Clave de API-Football (https://dashboard.api-football.com, cabecera x-apisports-key)
API_FOOTBALL_KEY=

# Clave para firmar los tokens de sesion (OBLIGATORIA, minimo 32 caracteres, aleatoria).
# Genera una con:  openssl rand -base64 48   (o cualquier generador de contrasenas largas)
JWT_SECRET=

# Primer administrador: se crea al arrancar si ambos estan rellenos y ese email no existe.
# La contrasena debe tener de 8 a 72 caracteres. Los endpoints /api/admin/** solo los usa un ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Servidor de correo para la verificacion del email y el "he olvidado mi contrasena".
# Si MAIL_HOST se queda vacio NO se envia nada: el backend escribe el correo entero (con el enlace)
# en su log, que es suficiente para probarlo en desarrollo (docker compose logs -f backend).
# Con Gmail hay que usar una "contrasena de aplicacion", no la del correo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Remitente de esos correos (lo que ve el destinatario en el campo De).
MAIL_FROM=no-reply@ligacomunio.local

# Base de los enlaces que viajan en el correo, sin barra final: es la URL del frontend.
# En desarrollo, http://localhost:5173. Al publicar, el dominio real con https.
FRONTEND_URL=http://localhost:5173

# Con true el login exige tener el email confirmado (responde 403 mientras no lo este).
# Dejalo en false hasta tener SMTP de verdad: sin MAIL_HOST el enlace solo sale por el log y
# cualquiera que se registre se quedaria fuera.
EXIGIR_EMAIL_VERIFICADO=false
